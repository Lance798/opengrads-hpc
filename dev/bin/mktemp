#!/usr/bin/env bash
# Keep legacy test templates below this checkout's TMPDIR.
set -euo pipefail
args=()
for arg in "$@"; do
  case "$arg" in
    /tmp/*) arg="${TMPDIR:?}/${arg#/tmp/}" ;;
    --tmpdir=/tmp) arg="--tmpdir=${TMPDIR:?}" ;;
  esac
  args+=("$arg")
done
exec /usr/bin/mktemp "${args[@]}"
